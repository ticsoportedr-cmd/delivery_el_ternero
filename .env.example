# ============================================================
# EL TERNERO - Variables de entorno
# Copiar este archivo como ".env" y completar los valores.
# El archivo .env NUNCA se sube a GitHub (está en .gitignore).
# ============================================================

# Puerto local del servidor (Calcol no se toca).
PORT=3200

# Clave de Gemini (opcional: resumen de instrucciones y consejos de entrega).
GEMINI_API_KEY=

# Clave de Google Maps del proyecto EL TERNERO (se usará en la Fase 2).
VITE_GOOGLE_MAPS_API_KEY=

# Ruta del archivo de datos (opcional). Por defecto: data/data_store.json
# DATA_FILE=
